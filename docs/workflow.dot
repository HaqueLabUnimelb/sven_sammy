// Workflow diagram of the front-page README.
// Render: dot -Tsvg docs/workflow.dot -o docs/workflow.svg   (Graphviz 12.2.0)
digraph workflow {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=20, fontcolor="#1f3a60",
         nodesep=0.45, ranksep=0.75, pad=0.35, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5", penwidth=1.5,
         fontname="Helvetica", fontsize=18, fontcolor="#1a1a1a", margin="0.28,0.14"];
  edge  [color="#4a6fa5", penwidth=1.8, arrowsize=1.0];

  subgraph cluster_p1 {
    label="Part 1: scRNA-seq"; style="rounded"; color="#9db2d3"; penwidth=1.5;
    cellranger [label="Cell Ranger"];
    seurat     [label="Seurat: clustering\nand cell labels"];
  }
  subgraph cluster_p2 {
    label="Part 2: CellChat"; style="rounded"; color="#9db2d3"; penwidth=1.5;
    cellchat [label="MNP2 cells with\nCD4 T cells"];
  }
  subgraph cluster_p3 {
    label="Part 3: Stereo-seq v1.3"; style="rounded"; color="#9db2d3"; penwidth=1.5;
    saw     [label="SAW (Stereo-seq\nAnalysis Workflow)"];
    bin20   [label="bin20 count matrix"];
    rctd    [label="RCTD cell-type\nweights"];
    hotspot [label="Hotspot gene\nmodules"];
    dbscan  [label="DBSCAN regions, enrichment,\ncolocalisation"];
  }

  cellranger -> seurat;
  seurat -> cellchat [minlen=2];
  seurat -> rctd;
  saw -> bin20;
  bin20 -> rctd;
  bin20 -> hotspot;
  rctd -> dbscan;
  hotspot -> dbscan;
}
